{
  "name": "batteryincluded",
  "type": "module",
  "version": "1.0.5",
  "packageManager": "pnpm@12.15.0",
  "description": "A TypeScript client for the BatteryIncluded API",
  "author": "Frederik Bußmann <frederik@bussmann.io>",
  "license": "MIT",
  "repository": "bussmann-io/batteryincluded-ts",
  "keywords": [
    "batteryincluded",
    "api",
    "sdk",
    "typescript",
    "e-commerce",
    "ai",
    "search"
  ],
  "exports": {
    ".": "./dist/index.mjs"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "batteryincluded": "dist/cli/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "autodisco": "^2.1.0",
    "c12": "^4.0.0-rc.3",
    "citty": "^0.2.2",
    "defu": "^6.1.7",
    "dotenv": "^18.0.9",
    "jiti": "^2.7.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "msw": "^3.0.3",
    "obuild": "^0.4.45",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
